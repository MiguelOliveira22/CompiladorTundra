INPP
AMEM 1
DSVS MAIN

PROC_1_p:
ENPR 1
AMEM 1
DSVS PROC_1_p_BODY

PROC_2_f:
ENPR 2
DSVS PROC_2_f_BODY

PROC_2_f_BODY:
CRVL 2,-4
CRCT 0
CMME
DSVF _ELSE_1
DSVR L2_200,1,2
DSVS _ENDIF_2

_ELSE_1:
CRVL 2,-4
CRCT 0
CMIG
DSVF _ELSE_3
CRCT 2
ARMZ 2,-5
DSVS _ENDIF_4

_ELSE_3:
AMEM 1
CRVL 2,-4
CRCT 2
SUBT
CHPR PROC_2_f,2
CRVL 2,-4
MULT
CRCT 1
SOMA
ARMZ 2,-5

_ENDIF_4:

_ENDIF_2:
RTPR 2,1

PROC_1_p_BODY:

L2_100:
AMEM 1
CRVI 1,-4
CHPR PROC_2_f,1
ARMZ 1,0
CRVL 1,0
ARMI 1,-4
CRVI 1,-4
CRVL 0,0
CMME
DSVF _ELSE_5
DSVR L2_100,1,1

_ELSE_5:

L2_200:
CRVL 0,0
CRCT 1
SUBT
ARMZ 0,0
DMEM 1
RTPR 1,1

PROC_1_r:
